# Nega accesso diretto ai file di configurazione (segreti)
<FilesMatch "^config.*\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Niente listing delle directory
Options -Indexes
